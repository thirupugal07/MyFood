# Copy this file to .env.local and adjust as needed.

# "true"  -> the app uses the built-in mock API (default, no backend required)
# "false" -> the app talks to a real backend at VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Base URL of the backend. Leave as /api to use the Vite dev proxy.
VITE_API_BASE_URL=/api

# Only used by the Vite dev proxy in vite.config.js
VITE_PROXY_TARGET=http://localhost:8080
